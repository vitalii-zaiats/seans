# Copy to `.env` at the repository root before `docker compose -f compose.prod.yaml up`.
#
# Compose reads `.env` from the directory it is run in, and `.env` is already in
# `.gitignore` — check that before putting a password in it.

# The apex. Caddy derives api./tv./admin./remote. from this, so every one of
# them needs an A (and AAAA, if you have one) record pointing at this server.
DOMAIN=seans-kino.online

# Where Let's Encrypt writes when a certificate is about to lapse. Not optional
# in practice: without it the first warning is a browser error.
ACME_EMAIL=you@example.com

# Anything but the default. This is the one secret in the file.
POSTGRES_PASSWORD=

# Optional. Where the Android build lives, for the downloads page. Leave empty
# until there is one — the page then says so instead of offering a dead link.
API_SELF_UPDATE_URL=
