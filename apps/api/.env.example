# Everything the API reads. Copy to .env and edit what you need.

API_DATABASE_URL=postgresql+asyncpg://movies:movies@127.0.0.1:5433/movies
API_HOST=127.0.0.1
API_PORT=8000

# --- releases ---------------------------------------------------------------
API_MIN_VERSION=1.0.0
API_LATEST_VERSION=1.0.0
# Per-platform overrides, JSON. A platform absent here falls back to the above.
# API_MIN_VERSIONS={"android": "1.0.0", "windows": "0.9.0"}
# API_LATEST_VERSIONS={"android": "1.2.0"}

# Where a build that updates itself fetches the new one. Never used for a Play
# Store install — that one is sent to the listing instead.
# API_SELF_UPDATE_URL=https://supermovies.example/download/latest
API_ANDROID_PACKAGE=com.supermovies.app

# --- features ---------------------------------------------------------------
# API_FEATURES={"downloads": true, "external_players": true}
# Forced off for a Play Store install, whatever the line above says.
# API_STORE_DISABLED_FEATURES=["external_players"]
